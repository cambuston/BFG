# Copia este archivo a .env y ajústalo. No subas .env a ningún lado.

# Marca que sirve este proceso: flecos | barbas
# Si lo dejas vacío, se decide por el dominio de cada petición (barbas.mx → barbas).
BRAND=flecos

PORT=3100

# Archivo SQLite. En producción, algo fuera del árbol del código:
# FYB_DB_PATH=/opt/flecosybarbas/data/flecosybarbas.db
# FYB_DB_PATH=./data/flecosybarbas.db

# ---------- Cuenta social ----------
# demo     = los tres botones funcionan con una identidad de mentiras.
#            Sirve para probar el flujo completo sin dar de alta nada.
# supabase = login real con Google / Apple / Facebook.
AUTH_MODE=demo

# Solo con AUTH_MODE=supabase. Se sacan del panel de Supabase:
#   Project Settings → API
# La anon key es pública por diseño (va en el navegador).
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
#
# Además, en el panel de Supabase hay que:
#   1. Authentication → Providers: prender Google, Apple y Facebook.
#   2. Authentication → URL Configuration: agregar a "Redirect URLs"
#      http://localhost:3100/ y https://flecos.mx/ y https://barbas.mx/
