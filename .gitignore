# Base de datos local (nunca a git)
data/
*.db
*.db-shm
*.db-wal

# Secretos. `.env.*` cubre las copias (.env.bak, .env.antes-de-algo…), que
# traen los mismos secretos y antes se colaban como archivos nuevos.
.env
.env.*
!.env.example

# Capturas que generan las pruebas de navegador (se rehacen con npm test)
test/screenshots/

# Local del agente. settings.json SÍ se sube (permisos del proyecto);
# settings.local.json no (preferencias personales de cada máquina).
.claude/settings.local.json
.DS_Store

# Muestras de color: las regenera `node colores/ver.js`
colores/muestras/
colores/muestras-familias/
